# Caminho relativo: app e API mockada são sempre same-origin (o MSW intercepta
# fetch/XHR na própria página), então isso funciona igual em dev, preview e produção.
VITE_API_BASE_URL=/api

# Vazio = mesma origem da página (window.location.origin). Só defina um valor
# absoluto se o servidor de Socket.IO rodar em outra origem.
VITE_SOCKET_URL=

# Liga/desliga a camada de mocks (MSW). Deve permanecer "true" no build de demonstração.
VITE_API_MOCKING=true
